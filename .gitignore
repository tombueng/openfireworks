# This repository holds the OUTCOME (design files, fab outputs, enclosure, firmware, web app) and the scripts
# that reproduce it. Not in it: the owner's own resources — reviews, older versions, sourcing / shop data,
# datasheets (copyright of their makers), notes, orders, intermediate build output. They stay local.

# --- local tooling / environments ---
/tools/cadenv/
/tools/btenv/
/tools/freerouting/
node_modules/
__pycache__/
*.pyc
/.claude/
/.never-stop/
/logs/

# --- intermediate build output, reviews, status/handover notes ---
/build/

# --- firmware build output ---
/firmware/**/build/

# --- KiCad local files ---
/hw/.history/
*.kicad_prl
*-backups/
fp-info-cache
*.lck
_autosave-*

# --- datasheets, sourcing, old parts: local only ---
/hw/datasheets/
/hw/3dmodels/*
!/hw/3dmodels/BatteryHolder_Keystone_2477_4xAA.step
!/hw/3dmodels/ESP32C3_SuperMini_MINIV1.step
!/hw/3dmodels/Jack_35mm_PJ320A.step
!/hw/3dmodels/Switch_Slide_LightCountry_5MS1_M6.step
/hw/footprints/OpenFireworks.pretty/*
!/hw/footprints/OpenFireworks.pretty/BatteryHolder_Keystone_2477_4xAA.kicad_mod
!/hw/footprints/OpenFireworks.pretty/ESP32C3_SuperMini_MINIV1.kicad_mod
!/hw/footprints/OpenFireworks.pretty/Jack_35mm_PJ320A_THT.kicad_mod
!/hw/footprints/OpenFireworks.pretty/Switch_Slide_LightCountry_5MS1_M6.kicad_mod
/hw/modules/*
!/hw/modules/ESP32C3_SuperMini_MINIV1.kicad_pcb

# --- docs: only the published design + build docs ---
/docs/*
!/docs/README.md
!/docs/RESPIN3_DESIGN.md
!/docs/RESPIN3_BUILD_AND_FIRMWARE.md
!/docs/REPRODUCE.md

# --- enclosure: reviews, check images, logs, private packaging ---
/enclosure/review_buttons/
/enclosure/renders/*.log
/enclosure/viewer/make_artifact.py
/enclosure/viewer/artifact/
/enclosure/print/make_zip.sh
/enclosure/print/_tmp/

# --- exports: shop BOMs, module previews, private packages ---
/export/bom_*.csv
/export/modules/
/export/print/
/export/viewer/

