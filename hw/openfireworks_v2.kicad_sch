	(text "SOFTWARE ARM: Q27 (HIGH-SIDE P-FET VSYS->VFIRE) switches the WHOLE firing rail. DISARMED -> Q27 off + 47k bleed -> VFIRE DEAD. (Armed state is shown by firmware on a WS2812.)"
		(exclude_from_sim no)
		(at 35.56 149.86 0)
